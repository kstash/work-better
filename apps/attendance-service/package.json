{
  "name": "@work-better/attendance-service",
  "version": "1.0.0",
  "private": true,
  "description": "Attendance service for Work Better",
  "scripts": {
    "build": "nest build attendance-service",
    "start": "node ../../dist/apps/attendance-service/src/main.js",
    "start:dev": "nest start attendance-service --watch --preserveWatchOutput",
    "dev": "nest start attendance-service --watch --preserveWatchOutput",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:cov": "jest --coverage",
    "install-local-deps": "mkdir -p node_modules/@work-better && cp -r ../../libs/common node_modules/@work-better/"
  },
  "dependencies": {
    "@nestjs/common": "^10.0.0",
    "@nestjs/core": "^10.0.0",
    "@nestjs/mongoose": "^11.0.3",
    "@nestjs/config": "^3.1.1",
    "mongoose": "^7.8.6",
    "rxjs": "^7.8.1",
    "@work-better/common": "file:../../libs/common"
  },
  "devDependencies": {
    "@types/node": "^20.3.1",
    "@types/jest": "^29.5.12",
    "typescript": "^5.1.3",
    "ts-node": "^10.9.1",
    "jest": "^29.7.0",
    "ts-jest": "^29.1.2"
  }
}
