{
  "$schema": "https://json.schemastore.org/nest-cli",
  "collection": "@nestjs/schematics",
  "sourceRoot": "apps",
  "monorepo": true,
  "root": ".",
  "compilerOptions": {
    "webpack": true,
    "tsConfigPath": "tsconfig.json",
    "builder": "webpack",
    "deleteOutDir": true
  },
  "projects": {
    "user-service": {
      "type": "application",
      "root": "apps/user-service",
      "entryFile": "main",
      "sourceRoot": "apps/user-service/src",
      "compilerOptions": {
        "tsConfigPath": "apps/user-service/tsconfig.json",
        "assets": ["**/*.proto"],
        "watchAssets": true
      }
    },
    "auth-service": {
      "type": "application",
      "root": "apps/auth-service",
      "entryFile": "main",
      "sourceRoot": "apps/auth-service/src",
      "compilerOptions": {
        "tsConfigPath": "apps/auth-service/tsconfig.json",
        "assets": ["**/*.proto"],
        "watchAssets": true
      }
    },
    "attendance-service": {
      "type": "application",
      "root": "apps/attendance-service",
      "entryFile": "main",
      "sourceRoot": "apps/attendance-service/src",
      "compilerOptions": {
        "tsConfigPath": "apps/attendance-service/tsconfig.json",
        "assets": ["**/*.proto"],
        "watchAssets": true
      }
    },
    "leave-service": {
      "type": "application",
      "root": "apps/leave-service",
      "entryFile": "main",
      "sourceRoot": "apps/leave-service/src",
      "compilerOptions": {
        "tsConfigPath": "apps/leave-service/tsconfig.json",
        "assets": ["**/*.proto"],
        "watchAssets": true
      }
    },
    "common": {
      "type": "library",
      "root": "libs/common",
      "entryFile": "index",
      "sourceRoot": "libs/common/src",
      "compilerOptions": {
        "tsConfigPath": "libs/common/tsconfig.json"
      }
    }
  }
}
