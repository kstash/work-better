{
  "$schema": "https://json.schemastore.org/nest-cli",
  "collection": "@nestjs/schematics",
  "sourceRoot": "apps",
  "monorepo": true,
  "root": ".",
  "compilerOptions": {
    "webpack": true,
    "tsConfigPath": "tsconfig.json",
    "builder": "webpack",
    "deleteOutDir": true
  },
  "projects": {
    "user": {
      "type": "application",
      "root": "apps/user",
      "entryFile": "main",
      "sourceRoot": "apps/user/src",
      "compilerOptions": {
        "tsConfigPath": "apps/user/tsconfig.json",
        "assets": ["**/*.proto"],
        "watchAssets": true
      }
    },
    "auth": {
      "type": "application",
      "root": "apps/auth",
      "entryFile": "main",
      "sourceRoot": "apps/auth/src",
      "compilerOptions": {
        "tsConfigPath": "apps/auth/tsconfig.json",
        "assets": ["**/*.proto"],
        "watchAssets": true
      }
    },
    "attendance": {
      "type": "application",
      "root": "apps/attendance",
      "entryFile": "main",
      "sourceRoot": "apps/attendance/src",
      "compilerOptions": {
        "tsConfigPath": "apps/attendance/tsconfig.json",
        "assets": ["**/*.proto"],
        "watchAssets": true
      }
    },
    "leave": {
      "type": "application",
      "root": "apps/leave",
      "entryFile": "main",
      "sourceRoot": "apps/leave/src",
      "compilerOptions": {
        "tsConfigPath": "apps/leave/tsconfig.json",
        "assets": ["**/*.proto"],
        "watchAssets": true
      }
    },
    "common": {
      "type": "library",
      "root": "libs/common",
      "entryFile": "index",
      "sourceRoot": "libs/common/src",
      "compilerOptions": {
        "tsConfigPath": "libs/common/tsconfig.json"
      }
    }
  }
}
