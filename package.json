{
  "name": "work-better",
  "version": "1.0.0",
  "description": "Work Better: HR Management System",
  "author": "Seungtae Kim",
  "private": true,
  "license": "UNLICENSED",
  "scripts": {
    "format": "prettier --write \"{src,apps,libs}/**/*.ts\" \"test/**/*.ts\"",
    "lint": "eslint \"{src,apps,libs,test}/**/*.ts\" --fix",
    "start": "npm-run-all -p start:auth start:user start:attendance start:leave",
    "build": "npm-run-all build:common build:services",
    "build:common": "cd libs/common && npm run build",
    "build:services": "npm-run-all build:attendance build:auth build:user build:leave",
    "build:attendance": "cd apps/attendance-service && npm run build",
    "build:auth": "cd apps/auth-service && npm run build",
    "build:user": "cd apps/user-service && npm run build",
    "build:leave": "cd apps/leave-service && npm run build",
    "start:attendance": "node dist/apps/attendance-service/src/main.js",
    "start:auth": "node dist/apps/auth-service/src/main.js",
    "start:user": "node dist/apps/user-service/src/main.js",
    "start:leave": "node dist/apps/leave-service/src/main.js",
    "start:dev": "npm-run-all -p start:dev:*",
    "start:dev:attendance": "cd apps/attendance-service && npm run start:dev",
    "start:dev:auth": "cd apps/auth-service && npm run start:dev",
    "start:dev:user": "cd apps/user-service && npm run start:dev",
    "start:dev:leave": "cd apps/leave-service && npm run start:dev",
    "setup-services": "npm-run-all build:common install-local-deps build",
    "install-local-deps": "npm-run-all install-local-deps:*",
    "install-local-deps:attendance": "cd apps/attendance-service && npm run install-local-deps",
    "install-local-deps:auth": "cd apps/auth-service && npm run install-local-deps",
    "install-local-deps:user": "cd apps/user-service && npm run install-local-deps",
    "install-local-deps:leave": "cd apps/leave-service && npm run install-local-deps"
  },
  "dependencies": {
    "@nestjs-modules/ioredis": "^2.0.2",
    "@nestjs/axios": "^4.0.0",
    "@nestjs/common": "^10.0.0",
    "@nestjs/config": "^3.1.1",
    "@nestjs/core": "^10.0.0",
    "@nestjs/jwt": "^10.2.0",
    "@nestjs/microservices": "^10.4.15",
    "@nestjs/mongoose": "^11.0.3",
    "@nestjs/passport": "^10.0.3",
    "@nestjs/platform-express": "^10.0.0",
    "@nestjs/terminus": "^11.0.0",
    "@nestjs/typeorm": "^10.0.1",
    "@nestjs/websockets": "^10.4.15",
    "@types/passport-naver": "^1.0.4",
    "axios": "^1.8.4",
    "bcrypt": "^5.1.1",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.0",
    "ioredis": "^5.6.0",
    "mongoose": "^7.8.6",
    "passport": "^0.7.0",
    "passport-google-oauth20": "^2.0.0",
    "passport-jwt": "^4.0.1",
    "passport-naver": "^1.0.6",
    "pg": "^8.11.3",
    "reflect-metadata": "^0.1.13",
    "rxjs": "^7.8.1",
    "typeorm": "^0.3.17"
  },
  "devDependencies": {
    "@nestjs/cli": "^10.0.0",
    "@nestjs/schematics": "^10.0.0",
    "@nestjs/testing": "^10.0.0",
    "@types/bcrypt": "^5.0.2",
    "@types/express": "^4.17.21",
    "@types/jest": "^29.5.12",
    "@types/node": "^20.3.1",
    "@types/passport-google-oauth20": "^2.0.14",
    "@types/passport-jwt": "^4.0.0",
    "@types/pg": "^8.11.0",
    "@typescript-eslint/eslint-plugin": "^7.18.0",
    "@typescript-eslint/parser": "^7.18.0",
    "eslint": "^8.56.0",
    "eslint-config-prettier": "^9.0.0",
    "eslint-plugin-prettier": "^5.0.0",
    "jest": "^29.7.0",
    "nodemon": "^3.1.9",
    "npm-run-all": "^4.1.5",
    "prettier": "^3.0.0",
    "rimraf": "^5.0.0",
    "ts-jest": "^29.1.2",
    "ts-loader": "^9.4.3",
    "ts-node": "^10.9.1",
    "ts-node-dev": "^2.0.0",
    "tsconfig-paths": "^4.2.0",
    "typescript": "^5.1.3"
  },
  "jest": {
    "moduleFileExtensions": [
      "js",
      "json",
      "ts"
    ],
    "rootDir": "src",
    "testRegex": ".*\\.spec\\.ts$",
    "transform": {
      "^.+\\.(t|j)s$": "ts-jest"
    },
    "collectCoverageFrom": [
      "**/*.(t|j)s"
    ],
    "coverageDirectory": "../coverage",
    "testEnvironment": "node"
  },
  "workspaces": [
    "apps/*",
    "libs/*"
  ]
}
